DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated Google emails that get the ADMIN role and the dashboard.
# Any other Google account can still sign in, but only at /join to register
# as a member (fail-closed if empty: nobody gets admin).
ADMIN_ALLOWED_EMAILS="owner@example.com"
