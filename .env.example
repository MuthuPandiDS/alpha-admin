DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cashfree PG (https://merchant.cashfree.com → Developers → API keys)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# "sandbox" (default) or "production"
CASHFREE_ENV="sandbox"
# Optional: pin the Cashfree API version. Defaults to 2023-08-01.
CASHFREE_API_VERSION="2023-08-01"
# Optional: only set if your webhook secret differs from the PG secret key.
CASHFREE_WEBHOOK_SECRET=""
# Public base URL Cashfree calls back on. Falls back to AUTH_URL.
APP_URL="http://localhost:3000"

# Comma-separated Google emails that get the ADMIN role and the dashboard.
# Any other Google account can still sign in, but only at /join to register
# as a member (fail-closed if empty: nobody gets admin).
ADMIN_ALLOWED_EMAILS="owner@example.com"
