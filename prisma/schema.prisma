generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// GYM-1 role flag. Admin app sign-in always upgrades allowlisted users to ADMIN.
  role          String    @default("MEMBER")

  weightKg      Float?
  heightCm      Float?
  paymentStatus String    @default("UNPAID")
  planExpiresAt DateTime?
  planNotes     String?

  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  emergencyContact String?
  fitnessGoal      String?
  /// "ADMIN" when created from the dashboard, "QR" when self-registered via the join form.
  joinSource       String    @default("ADMIN")
  /// Set once the member submits the onboarding form. Null means the profile is still incomplete.
  profileCompletedAt DateTime?

  /// Membership plan the member is currently billed on.
  planId String?
  plan   MembershipPlan? @relation("UserCurrentPlan", fields: [planId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  measurements  BodyMeasurement[]
  announcements Announcement[]
  planEligibilities PlanEligibility[]
  payments          Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([planExpiresAt])
  @@index([planId])
}

/// A membership plan the admin sells, e.g. "New joiner 3 months" or "Legacy annual".
model MembershipPlan {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  /// Price in paise so money is never stored as a float.
  priceInPaise Int
  currency     String @default("INR")
  /// How many days the plan extends a membership when a payment succeeds.
  durationDays Int
  /// Plan handed to members who have no explicit plan. At most one plan can be the default.
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)
  /// When true only members listed in PlanEligibility may be put on this plan.
  isRestricted Boolean @default(false)

  members      User[]            @relation("UserCurrentPlan")
  eligibleUsers PlanEligibility[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// Grants one member access to one restricted plan.
model PlanEligibility {
  id     String @id @default(cuid())
  userId String
  planId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, planId])
  @@index([planId])
}

/// A Cashfree payment link raised for a member's plan, tracked end to end inside the app.
model Payment {
  id     String @id @default(cuid())
  userId String
  planId String?
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  amountInPaise Int
  currency      String @default("INR")
  /// PENDING | PAID | PARTIALLY_PAID | FAILED | EXPIRED | CANCELLED
  status        String @default("PENDING")
  /// "CASHFREE" for gateway collections, "MANUAL" for cash or offline entries.
  provider      String @default("CASHFREE")

  /// link_id sent to Cashfree; unique so webhook replays are idempotent.
  cashfreeLinkId  String? @unique
  cashfreeCfLinkId String?
  linkUrl         String?
  cashfreeOrderId String?
  amountPaidInPaise Int   @default(0)
  notes           String?
  /// Last webhook or status-refresh payload, kept for reconciliation.
  rawPayload      Json?

  paidAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Snapshot history for GYM-11 progress analytics. Current values also live on User.
model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float?
  heightCm   Float?
  recordedAt DateTime @default(now())
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  imageUrl    String?
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt, endsAt])
}

/// A category for gym operating expenses (e.g. Rent, Electricity, Salaries).
model ExpenseCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  emoji       String
  description String?
  /// true for the 15 seeded default categories; false for admin-created custom ones.
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// A recurring expense template that auto-generates individual Expense rows each period.
model RecurringExpense {
  id             String   @id @default(cuid())
  name           String
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Amount in paise (same convention as Payment.amountInPaise).
  amountInPaise  Int
  currency       String   @default("INR")
  /// MONTHLY | QUARTERLY | YEARLY | WEEKLY
  frequency      String   @default("MONTHLY")
  /// Day of the month the expense is due (1-31). Clamped to month length.
  dueDay         Int
  paymentMethod  String?
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean  @default(true)
  /// Tracks the last month+year for which an Expense was generated, preventing duplicates.
  lastGeneratedDate DateTime?

  expenses  Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([categoryId])
}

/// A single expense entry — either auto-generated from a RecurringExpense or manually created.
model Expense {
  id                 String   @id @default(cuid())
  name               String
  categoryId         String
  category           ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  /// Amount in paise.
  amountInPaise      Int
  currency           String   @default("INR")
  /// UPCOMING | DUE | PAID | OVERDUE
  status             String   @default("UPCOMING")
  dueDate            DateTime
  paidDate           DateTime?
  paymentMethod      String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([categoryId])
  @@index([recurringExpenseId])
}
