generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// GYM-1 role flag. Admin app sign-in always upgrades allowlisted users to ADMIN.
  role          String    @default("MEMBER")

  weightKg      Float?
  heightCm      Float?
  paymentStatus String    @default("UNPAID")
  planExpiresAt DateTime?
  planNotes     String?

  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  emergencyContact String?
  fitnessGoal      String?
  /// "ADMIN" when created from the dashboard, "QR" when self-registered via the join form.
  joinSource       String    @default("ADMIN")
  /// Set once the member submits the onboarding form. Null means the profile is still incomplete.
  profileCompletedAt DateTime?

  accounts      Account[]
  sessions      Session[]
  measurements  BodyMeasurement[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([planExpiresAt])
}

/// Snapshot history for GYM-11 progress analytics. Current values also live on User.
model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float?
  heightCm   Float?
  recordedAt DateTime @default(now())
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  imageUrl    String?
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt, endsAt])
}
